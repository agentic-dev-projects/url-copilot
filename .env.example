# ── Application ───────────────────────────────────────────────────────────────
# Public base URL used when constructing short URLs returned to clients
BASE_URL=http://localhost:8000

# Set to true only in local development — never in production
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Update host to 'db' when running inside Docker Compose
DATABASE_URL=postgresql://postgres:password@localhost:5432/urlcopilot

# ── Cache ─────────────────────────────────────────────────────────────────────
# Format: redis://<host>:<port>/<db_index>
# Update host to 'cache' when running inside Docker Compose
REDIS_URL=redis://localhost:6379/0

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Maximum API requests per minute per API key
RATE_LIMIT_PER_MINUTE=60

# ── Orchestrator: OpenAI ──────────────────────────────────────────────────────
# API key for gpt-4o (doer agent) and o1-mini (validator agent)
OPENAI_API_KEY=sk-...

# ── Orchestrator: GitHub ──────────────────────────────────────────────────────
# Personal Access Token (PAT) for the service account — needs 'repo' scope
# Used to create branches, open PRs, and poll merge status
GITHUB_TOKEN=ghp_...
GITHUB_REPO=agentic-dev-projects/url-copilot

# ── Orchestrator: LangSmith observability ─────────────────────────────────────
# Sign up at https://smith.langchain.com to get an API key
# Every LLM call made through the orchestrator is automatically traced
# when these three variables are set — no code instrumentation needed.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=url-copilot
