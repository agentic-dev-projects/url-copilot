# ── Application ───────────────────────────────────────────────────────────────
# Public base URL used when constructing short URLs returned to clients
BASE_URL=http://localhost:8000

# Set to true only in local development — never in production
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Update host to 'db' when running inside Docker Compose
DATABASE_URL=postgresql://postgres:password@localhost:5432/urlcopilot

# ── Cache ─────────────────────────────────────────────────────────────────────
# Format: redis://<host>:<port>/<db_index>
# Update host to 'cache' when running inside Docker Compose
REDIS_URL=redis://localhost:6379/0

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Maximum API requests per minute per API key
RATE_LIMIT_PER_MINUTE=60
